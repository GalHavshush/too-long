  "title": "Ledger: billing service rewrite",
  "file": "realworld-plan",
  "intro": [
    {
      "type": "p",
      "text": "Move invoicing out of the monolith into `services/ledger/`. See `services/ledger/app.py` and `app.py`.",
      "line": 3
    },
    {
      "type": "callout",
      "kind": "decision",
      "blocks": [
        {
          "type": "p",
          "text": "Keep Postgres as the system of record. Rationale: the finance team already audits it."
        }
